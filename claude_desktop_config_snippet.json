{
  "mcpServers": {
    "unofficial-zaptec-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/holger1411/unofficialzaptecMCP",
        "unofficial-zaptec-mcp"
      ],
      "env": {
        "ZAPTEC_ENV_FILE": "/absolute/path/to/zaptec.env"
      }
    }
  }
}
